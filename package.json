{
  "name": "object-pickby",
  "version": "2.0.2",
  "description": "Creates an object composed of the picked object properties. Written in Typescript for ES2019+ environments.",
  "keywords": [
    "lodash-es",
    "lodash-modularized",
    "object",
    "only",
    "pick",
    "pickby"
  ],
  "homepage": "https://github.com/tinovyatkin/object-pick#readme",
  "bugs": {
    "url": "https://github.com/tinovyatkin/object-pick/issues"
  },
  "license": "MIT",
  "author": "Konstantin Vyatkin <tino@vtkn.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinovyatkin/object-pick.git"
  },
  "files": [
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "dist/**/*.js"
  ],
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    "import": "./dist/esm/index.js",
    "require": "./dist/cjs/index.cjs"
  },
  "scripts": {
    "prepack": "lefthook install",
    "prebuild": "rm -rf dist",
    "build": "tsc --module es2022 --moduleResolution node --outDir ./dist/esm && tsc --module commonjs --moduleResolution node --outDir ./dist/cjs",
    "postbuild": "mv ./dist/cjs/index.js ./dist/cjs/index.cjs && mv ./dist/cjs/index.js.map ./dist/cjs/index.cjs.map",
    "lint": "oxlint --type-aware ./src",
    "prepublishOnly": "npm test && npm build",
    "test": "node --no-warnings --enable-source-maps --experimental-vm-modules ./node_modules/.bin/jest"
  },
  "devDependencies": {
    "@types/jest": "29.5.8",
    "jest": "29.7.0",
    "jest-extended": "4.0.2",
    "lefthook": "2.0.15",
    "oxfmt": "0.26.0",
    "oxlint": "1.41.0",
    "oxlint-tsgolint": "0.11.1",
    "ts-jest": "29.1.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=12.4"
  }
}
